        <mxCell id="2T6f-hqnfI-JWMcStxQ4-13" value="&lt;font&gt;Дальний восток&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=26;" vertex="1" parent="1">
